#cloud-config
# Rendered by Terraform's templatefile (main.tf) for each web VM, with its
# name. A tiny web server and nothing to install: python3 ships with Ubuntu,
# and the web subnet has no default outbound access. It answers on port 80
# with the VM's name, so a curl through the gateway shows which VM replied.
# python3's server sends a Server header, which the gateway's rewrite set
# removes.

write_files:
  - path: /etc/systemd/system/lab-http.service
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Description=Lab web server: python3 -m http.server on port 80
      Wants=network-online.target
      After=network-online.target

      [Service]
      ExecStartPre=/bin/sh -c 'mkdir -p /srv/lab && echo "${name}" > /srv/lab/index.html'
      ExecStart=/usr/bin/python3 -m http.server 80 --directory /srv/lab
      Restart=always

      [Install]
      WantedBy=multi-user.target

runcmd:
  - systemctl daemon-reload
  - systemctl enable --now lab-http.service
