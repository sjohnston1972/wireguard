#cloud-config
# Rendered by Terraform's templatefile (main.tf) for vm-router; it takes no
# variables. Azure forwards packets to the router only because its NIC has
# IP forwarding on; Linux passes them on only with ip_forward set here. A
# one-NIC router would otherwise send ICMP redirects back to the spokes, so
# those are off. Nothing to install: sysctl is part of every Ubuntu image.

write_files:
  - path: /etc/sysctl.d/90-lab-router.conf
    owner: root:root
    permissions: "0644"
    content: |
      net.ipv4.ip_forward = 1
      net.ipv4.conf.all.send_redirects = 0
      net.ipv4.conf.default.send_redirects = 0

runcmd:
  - sysctl --system
