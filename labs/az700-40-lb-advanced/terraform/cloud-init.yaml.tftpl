#cloud-config
# Rendered by Terraform's templatefile (main.tf) for each web VM, with its
# name and region. A tiny web server and nothing to install: python3 ships
# with Ubuntu, and the web subnets have no default outbound access. It
# answers on port 80 with "<name> in <region>", so a curl through any of the
# load balancers shows which VM, in which region, replied.

write_files:
  - path: /etc/systemd/system/lab-http.service
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Description=Lab web server: python3 -m http.server on port 80
      Wants=network-online.target
      After=network-online.target

      [Service]
      ExecStartPre=/bin/sh -c 'mkdir -p /srv/lab && echo "${name} in ${region}" > /srv/lab/index.html'
      ExecStart=/usr/bin/python3 -m http.server 80 --directory /srv/lab
      Restart=always

      [Install]
      WantedBy=multi-user.target

runcmd:
  - systemctl daemon-reload
  - systemctl enable --now lab-http.service
