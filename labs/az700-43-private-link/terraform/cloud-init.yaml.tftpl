#cloud-config
# Rendered by Terraform's templatefile (main.tf) for vm-svc, with no values
# (a .tftpl keeps Unix line ends on any checkout). A tiny web server and
# nothing to install: python3 ships with Ubuntu. It answers on port 80 with
# a page naming the provider, and its log (journalctl -u lab-http) shows
# every request arriving from pls-svc's NAT address in snet-pls.

write_files:
  - path: /srv/lab/index.html
    owner: root:root
    permissions: "0644"
    content: |
      vm-svc in vnet-provider, published through pls-svc
  - path: /etc/systemd/system/lab-http.service
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Description=Lab web server: python3 -m http.server on port 80
      Wants=network-online.target
      After=network-online.target

      [Service]
      ExecStart=/usr/bin/python3 -m http.server 80 --directory /srv/lab
      Restart=always

      [Install]
      WantedBy=multi-user.target

runcmd:
  - systemctl daemon-reload
  - systemctl enable --now lab-http.service
