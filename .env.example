# wg-admin .env  --  the ONE file Steven fills in. Never committed (see .gitignore).
# "npm run secrets" pushes each value to where it is needed: GitHub repository
# secrets (for Terraform in Actions) and Worker secrets (for the Cloudflare Worker).
# Every key has a matching line in .env.example with a plain-English comment.

## ── Azure ────────────────────────────────────────────────────────────────
# Service principal. Today it is Contributor on the whole subscription (verified
# 2026-09-22). Good enough for v1; scoping it down is a backlog hardening item.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=rg-wg-ondemand
AZURE_REGION=uksouth
AZURE_VM_SIZE=Standard_B1s
# The VNet the VM lives in. Clients can opt in to routing it through the tunnel.
AZURE_VNET_CIDR=10.50.0.0/16

## ── Cloudflare ───────────────────────────────────────────────────────────
# Broad account token. Used ONLY on this machine by bootstrap scripts and
# wrangler. Never pushed to GitHub.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Zone id for clydeford.net (looked up 2026-09-22).
CLOUDFLARE_ZONE_ID=
# Narrow token: Zone > DNS > Edit on clydeford.net ONLY. Goes to GitHub (Terraform
# writes wg.clydeford.net) and to the Worker (DNS verification). Steven mints this
# in the dashboard: My Profile > API Tokens > Create Token > Edit zone DNS.
# Until it is filled in, scripts fall back to CLOUDFLARE_API_TOKEN and print a warning.
CLOUDFLARE_DNS_TOKEN=

## ── Cloudflare Access (login gate for wg-admin.clydeford.net) ────────────
# Access app "wg-admin" was created 2026-09-22 (app id 51b8b50f-212d-4823-bedb-d51698fcf542)
# with one policy: allow stevie.johnston@gmail.com.
CF_ACCESS_TEAM_DOMAIN=clydeford.cloudflareaccess.com
CF_ACCESS_AUD=
CF_ACCESS_ALLOWED_EMAIL=stevie.johnston@gmail.com

## ── R2 (Terraform state) ─────────────────────────────────────────────────
# Bucket wg-admin-tfstate was created 2026-09-22 (location WEUR).
# The S3 keys must be minted by hand: R2 > Manage R2 API Tokens > Create API
# token > Object Read & Write, scoped to this bucket. Paste the two values here.
R2_BUCKET=wg-admin-tfstate
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

## ── WireGuard ────────────────────────────────────────────────────────────
# Server keypair generated 2026-09-22 (X25519). KEEP THE PRIVATE KEY FOREVER:
# every client config trusts the public key below. Rotating it means reissuing
# every client. The public key is derived from the private one and is shown in
# the UI; it is here only for convenience.
WG_SERVER_PRIVATE_KEY=
WG_SERVER_PUBLIC_KEY=
WG_DNS_NAME=wg.clydeford.net
WG_PORT=51820
WG_SUBNET=10.13.13.0/24
# Loopback test address on the VM (a dummy interface, like Loopback0 on a router).
# Outside the tunnel subnet on purpose: pinging it from a client proves routing.
WG_LOOPBACK_IP=10.13.255.1
# Home LAN. Enables the site-to-site route table in Azure. Blank to disable.
HOME_LAN_CIDR=192.168.1.0/24
# Public key of the home WireGuard container (needed for site-to-site, backlog).
HOME_WG_PUBLIC_KEY=
# Optional: CIDR allowed to SSH to the VM. Blank = the public IP that clicked
# Deploy (taken from CF-Connecting-IP at deploy time).
SSH_ALLOWED_CIDR=

## ── SSH ──────────────────────────────────────────────────────────────────
# Keypair generated 2026-09-22. Private key: ~/.ssh/wg-admin-azure_ed25519
# Log in with:  ssh -i ~/.ssh/wg-admin-azure_ed25519 azureuser@wg.clydeford.net
SSH_PUBLIC_KEY=

## ── GitHub (the Terraform runner) ────────────────────────────────────────
# Repo created 2026-09-22. The Worker needs a fine-grained PAT, scoped to this
# one repo, permissions: Actions Read & Write, Contents Read. Steven mints it at
# github.com > Settings > Developer settings > Fine-grained tokens.
# "npm run secrets" itself uses the gh CLI login already on this machine.
GITHUB_REPO=sjohnston1972/wireguard
GITHUB_TOKEN=
GITHUB_WORKFLOW=wg.yml

## ── Behaviour ────────────────────────────────────────────────────────────
AUTO_DESTROY_DEFAULT_HOURS=4
# Idle (no peer handshake) minutes before auto-destroy. 0 = never.
IDLE_DESTROY_MINUTES=0
# Soft monthly budget in GBP; dashboard shows a warning above this.
MONTHLY_BUDGET_GBP=10
# Optional webhook (Discord/Slack/ntfy/generic JSON) for deploy, destroy, failure,
# drift and cost-guard events. Blank = off.
NOTIFY_WEBHOOK_URL=
# ntfy.sh access token (free account > Account > Access tokens, starts tk_). Needed for
# ntfy.sh: anonymous posts from Cloudflare Workers hit the shared-IP daily quota.
NOTIFY_TOKEN=
