{
  "name": "wg-admin",
  "version": "0.1.0",
  "private": true,
  "description": "On-demand Azure WireGuard concentrator managed from a Cloudflare Worker",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "keys": "node scripts/keys.mjs",
    "peer": "node scripts/peer.mjs",
    "secrets": "node scripts/secrets.mjs",
    "tf-validate": "node scripts/tf-validate.mjs",
    "deploy-worker": "node scripts/deploy-worker.mjs",
    "rollback-worker": "node scripts/rollback-worker.mjs",
    "migrate": "node scripts/migrate.mjs",
    "test": "node scripts/labs-build.mjs && node --test \"scripts/test/*.test.mjs\" && vitest run",
    "dev": "node scripts/labs-build.mjs && node scripts/dev.mjs",
    "typecheck": "node scripts/labs-build.mjs && tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "home": "node scripts/home.mjs",
    "dev:web": "vite --config web/vite.config.ts",
    "dev:api": "node scripts/labs-build.mjs && node scripts/dev.mjs --api",
    "build:web": "node scripts/labs-build.mjs && vite build --config web/vite.config.ts",
    "seed": "node scripts/seed-scenarios.mjs",
    "shots": "node scripts/shots.mjs",
    "shots:diff": "node scripts/shots-diff.mjs",
    "bundle-size": "node scripts/bundle-size.mjs",
    "labs-build": "node scripts/labs-build.mjs",
    "labs-check": "node scripts/labs-check.mjs",
    "labs-tf": "node scripts/labs-tf.mjs",
    "labs-verify": "node scripts/labs-verify.mjs",
    "labs-setup": "node scripts/labs-setup.mjs",
    "labs-pr0-check": "node scripts/labs-pr0-check.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260922.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toast": "1.2.23",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tanstack/react-query": "5.104.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "cmdk": "1.1.1",
    "hono": "^4.13.8",
    "jose": "^6.2.12",
    "jsdom": "30.1.1",
    "lucide-react": "1.50.0",
    "qrcode-generator": "^2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "typescript": "^7.0.2",
    "uplot": "1.6.32",
    "vite": "8.3.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.136.3",
    "yaml": "2.9.1"
  }
}
