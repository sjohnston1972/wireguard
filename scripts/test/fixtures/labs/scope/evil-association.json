{
  "lab": "az104-03-mgmt-groups",
  "about": "Moving the subscription into a lab management group, by an association and by subscription_ids.",
  "expect": [["association", "azurerm_management_group_subscription_association.move"], ["association", "azurerm_management_group.with_sub"]],
  "plan": {
