      { "address": "azurerm_storage_container.c", "mode": "managed", "type": "azurerm_storage_container", "name": "c", "expressions": { "storage_account_id": { "references": ["azurerm_storage_account.worm.id", "azurerm_storage_account.worm"] } } },
