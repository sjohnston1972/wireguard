# Secrets: the only place they live locally is .env (plus copies of it such
# as .env.bak, and .dev.vars, which "npm run dev" writes from it).
.env
.env.*
.dev.vars
.dev.vars.*
*.pem
*.key
id_*
!.env.example

# Terraform
infra/.terraform/
infra/.terraform.lock.hcl.bak
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
!*.auto.tfvars.example

# Node / wrangler
node_modules/
.wrangler/
dist/
*.log

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/


# Client configs made by "npm run peer" (contain private keys)
peers/

# Packet captures downloaded from the dashboard (real traffic from the network)
*.pcap
*.pcapng
