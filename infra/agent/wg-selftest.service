[Unit]
# wg-selftest.service: the loopback test plug, once per boot. See wg-selftest.sh.
Description=wg-admin tunnel self-test
After=network-online.target wg-quick@wg0.service dnsmasq.service
Wants=network-online.target
Requires=wg-quick@wg0.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/wg-selftest.sh
# 75: another self-test (an on-demand health check) already holds the lock.
SuccessExitStatus=75
TimeoutStartSec=60s

[Install]
WantedBy=multi-user.target
